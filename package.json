{
  "name": "retruco-webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm cards:build && vite build",
    "cards:build": "node scripts/build-cards.mjs",
    "social:build": "node scripts/build-social-image.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "update:cpu": "node scripts/update-cpu-engine.mjs"
  },
  "dependencies": {
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@lucide/svelte": "1.61.0",
    "bits-ui": "2.20.0",
    "clsx": "2.1.1",
    "qrcode": "^1.5.4",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-cloudflare": "8.0.1",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.5",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  }
}
