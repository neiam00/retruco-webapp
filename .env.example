# Empty means use /api on the same origin (Vite proxies this during development).
API_ORIGIN=
# Optional public B2/CDN origin. Cards must be available under /cards/.
CARD_ASSET_ORIGIN=
# Optional measurement ID; leave empty to disable analytics locally.
GOOGLE_ANALYTICS_ID=

# Server-only runtime bindings on Cloudflare Pages. Never public build variables.
# Keep API_ORIGIN empty for the public /api endpoint.
# Local Vite development already proxies /api and does not need these values.
BACKEND_ORIGIN=
API_PROXY_SECRET=
