# Empty means use /api on the same origin (Vite proxies this during development).
API_ORIGIN=
# Optional public B2/CDN origin. Cards must be available under /cards/.
CARD_ASSET_ORIGIN=
# Optional measurement ID; leave empty to disable analytics locally.
GOOGLE_ANALYTICS_ID=

# Optional public canonical origin, e.g. https://cards.example.com.
# Set at build time to prerender public pages and pin metadata/sitemap URLs.
# Empty renders them per request, using the deployment's actual origin.
SITE_ORIGIN=

# Server-only runtime bindings on Cloudflare Pages. Never public build variables.
# Keep API_ORIGIN empty for the public /api endpoint.
# Local Vite development already proxies /api and does not need these values.
BACKEND_ORIGIN=
API_PROXY_SECRET=

# Login and account creation fetch its public Turnstile site key from the backend.
# Set TURNSTILE_SITE_KEY and TURNSTILE_SECRET_KEY only in backend/.env.
